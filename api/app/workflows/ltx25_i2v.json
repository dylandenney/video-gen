{
  "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
  "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default"}},
  "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "ltx-2.5-video-vae-bf16.safetensors"}},
  "audio_vae": {"class_type": "VAELoader", "inputs": {"vae_name": "ltx-2.5-audio-vae-bf16.safetensors"}},
  "image": {"class_type": "LoadImage", "inputs": {"image": "$image"}},
  "prep": {"class_type": "LTXVPreprocess", "inputs": {"image": ["image", 0], "img_compression": 18}},
  "pos": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": "$prompt"}},
  "neg": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": "$negative"}},
  "cond": {"class_type": "LTXVConditioning", "inputs": {"positive": ["pos", 0], "negative": ["neg", 0], "frame_rate": 24}},
  "latent": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": "$width", "height": "$height", "length": "$length", "batch_size": 1}},
  "i2v": {"class_type": "LTXVImgToVideoInplace", "inputs": {"vae": ["vae", 0], "image": ["prep", 0], "latent": ["latent", 0], "strength": 1.0, "bypass": false}},
  "audio_latent": {"class_type": "LTXVEmptyLatentAudio", "inputs": {"audio_vae": ["audio_vae", 0], "frames_number": "$length", "frame_rate": 24, "batch_size": 1}},
  "av": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["i2v", 0], "audio_latent": ["audio_latent", 0]}},
  "guider": {"class_type": "LTXVDualCFGGuider", "inputs": {"model": ["unet", 0], "positive": ["cond", 0], "negative": ["cond", 1], "video_cfg": 1.0, "audio_cfg": 1.0}},
  "noise": {"class_type": "RandomNoise", "inputs": {"noise_seed": "$seed"}},
  "sampler": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
  "sigmas": {"class_type": "ManualSigmas", "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
  "sample": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["sampler", 0], "sigmas": ["sigmas", 0], "latent_image": ["av", 0]}},
  "split": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["sample", 0]}},
  "decode": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["split", 0], "vae": ["vae", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 16}},
  "video": {"class_type": "CreateVideo", "inputs": {"images": ["decode", 0], "fps": 24}},
  "save": {"class_type": "SaveVideo", "inputs": {"video": ["video", 0], "filename_prefix": "musicvid/ltx25", "format": "auto", "format.codec": "auto"}}
}
